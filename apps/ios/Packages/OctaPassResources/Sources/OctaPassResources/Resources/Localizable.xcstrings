    "fileTools.safesHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الخزينة مجلد مشفّر. تُشفَّر محتويات الملفات وأسماؤها ملفًا ملفًا، وتُقفل مع خزنتك. قفل المجلد هنا تشفير دائمًا، وليس أذونات."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Safe is an encrypted folder. File contents and names are encrypted one file at a time, and it locks with your vault. Locking a folder is always encryption here, never permissions."
          }
        }
      }
    },
    "fileTools.safesTitle" : {
