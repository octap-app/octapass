          "stringUnit" : {
            "state" : "translated",
            "value" : "Managed by an organisation"
          }
        }
      }
    },
    "wifi.managedHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شبكة عمل أو دراسة أعدّتها مؤسستك. على iPhone وiPad وMac تعني كلمة «مُدارة» في إعدادات Wi-Fi أن ملف تهيئة ثبّت الشبكة: هذا يأتي من مؤسستك، ولا يغيّره هذا الخيار."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A work or school network that your organisation set up. On iPhone, iPad and Mac, “Managed” in the Wi-Fi settings means a configuration profile installed the network: that comes from your organisation, and this switch doesn’t change it."
          }
        }
      }
    },
    "wifi.network" : {
