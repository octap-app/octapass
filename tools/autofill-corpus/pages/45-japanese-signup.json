  "forms": [{ "field": "#f2", "type": "signup" }],
  "fills": [
    {
      "focus": "#f2",
      "pick": "generated-password",
      "expect": { "#f0": "", "#f1": "", "#f2": "Lantern-ruby-T7#qv-42", "#f3": "Lantern-ruby-T7#qv-42" }
    }
  ]
