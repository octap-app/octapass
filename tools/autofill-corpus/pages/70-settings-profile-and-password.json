{
  "description": "Settings page with two separate forms: a pre-filled profile form (full name, email, phone) and a change-password form (current, new, confirm); filling one must not touch the other",
  "fields": {
    "#p-name": "name",
    "#p-email": "email",
    "#p-phone": "tel",
    "#pw-current": "current-password",
    "#pw-new": "new-password",
    "#pw-confirm": "confirm-password"
  },
  "forms": [
    { "field": "#p-name", "type": "identity" },
    { "field": "#pw-current", "type": "change-password" }
  ],
  "fills": [
    {
      "focus": "#pw-current",
      "pick": "login",
      "expect": {
        "#p-name": "Jordan Lee",
        "#p-email": "jordan@example.test",
        "#p-phone": "+15555550123",
        "#pw-current": "correct-horse-42!",
        "#pw-new": "",
        "#pw-confirm": ""
      }
    },
    {
      "focus": "#pw-new",
      "pick": "generated-password",
      "expect": {
        "#p-email": "jordan@example.test",
        "#pw-current": "",
        "#pw-new": "Lantern-ruby-T7#qv-42",
        "#pw-confirm": "Lantern-ruby-T7#qv-42"
      }
    }
  ]
}
