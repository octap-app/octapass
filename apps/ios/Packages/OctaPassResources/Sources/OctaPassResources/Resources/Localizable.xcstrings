    "emergency.how" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطلب الوصول، فتصلك رسالة بريد فورًا ثم كل يوم بعدها. ما لم ترفض خلال فترة الانتظار، يحصل على وصول للقراءة فقط. يمكنك الرفض في أي وقت، حتى بعد ذلك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They ask for access, and you get an email straight away and every day after. Unless you deny it within the waiting period, they get read-only access. You can deny at any time, even after."
          }
        }
      }
    },
    "emergency.keyStale" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لهذه الخزنة مفتاح جديد، لذا لا يستطيع هذا الشخص فتح ما فيها. جدّد وصوله."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This vault has a new key, so this person can’t open what’s in it. Renew their access."
          }
        }
      }
    },
