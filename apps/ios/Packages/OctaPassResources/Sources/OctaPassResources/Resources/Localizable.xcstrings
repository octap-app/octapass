    "keyLog.alert.foreignRecord" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نُشر مفتاح لبريدك الإلكتروني لم يُنشئه هذا الحساب. قد يحاول شخص يتحكّم في الخادم قراءة ما يشاركه الناس معك. أخبر من تشارك معهم، وإن كانت هذه الخدمة المستضافة فأخبرنا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A key was published for your email that this account didn’t make. Someone with control of the server may be trying to read what people share with you. Tell the people you share with, and if this is the hosted service, tell us."
          }
        }
      }
    },
    "keyLog.alert.logChanged" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّرت مفاتيح سجلّ المفاتيح نفسه. هذا متوقَّع فقط إذا استُعيد خادمك دون أسراره. إن كنت تدير الخادم وتعرف السبب، يمكنك الوثوق بالسجلّ الجديد. وإلا فتعامل مع الخادم بحذر."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The key log’s own keys changed. That’s expected only if your server was restored without its secrets. If you run the server and know why, you can trust the new log. Otherwise, treat the server with suspicion."
          }
        }
      }
    },
    "keyLog.alert.logInconsistent" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجلّ المفاتيح لا يطابق تاريخه السابق، فقد أُعيدت كتابته أو تفرّع. قد يكون الخادم يتصرّف بشكل خاطئ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The key log doesn’t match its earlier history, so it’s been rewritten or forked. The server may be misbehaving."
          }
        }
      }
    },
    "keyLog.alert.ownRecordMissing" : {
      "extractionState" : "manual",
      "localizations" : {
