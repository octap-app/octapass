{
  "description": "Change password with current, new and confirm (autocomplete attributes present)",
  "fields": {
    "#current": "current-password",
    "#next": "new-password",
    "#next2": "confirm-password"
  },
  "forms": [{ "field": "#current", "type": "change-password" }],
  "fills": [
    {
      "focus": "#current",
      "pick": "login",
      "expect": { "#current": "correct-horse-42!", "#next": "", "#next2": "" }
    },
    {
      "focus": "#next",
      "pick": "generated-password",
      "expect": { "#current": "", "#next": "Lantern-ruby-T7#qv-42", "#next2": "Lantern-ruby-T7#qv-42" }
    }
  ]
}
