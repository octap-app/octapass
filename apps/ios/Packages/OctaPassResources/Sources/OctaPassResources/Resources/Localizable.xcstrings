      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مواقع تشترك في تسجيل دخول واحد. تُعرض بيانات دخول أحدها على البقية. لا تضف إلا مواقع تثق بأن ترى كلمة المرور نفسها. هذه القائمة مشفّرة مع خزنتك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sites that share one sign-in. A login for one is offered on the others. Add only sites you trust to see the same password. This list is encrypted with your vault."
          }
        }
      }
    },
