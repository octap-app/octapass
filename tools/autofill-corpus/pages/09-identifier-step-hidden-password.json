{
  "description": "Email-first sign-in, step 1: identifier only. A display:none password input sits in the same form and must not be filled.",
  "fields": {
    "#identifierId": "username",
    "#hiddenPassword": "none"
  },
  "forms": [{ "field": "#identifierId", "type": "identifier" }],
  "fills": [
    {
      "focus": "#identifierId",
      "pick": "login",
      "expect": { "#identifierId": "alex@example.test", "#hiddenPassword": "" }
    }
  ]
}
