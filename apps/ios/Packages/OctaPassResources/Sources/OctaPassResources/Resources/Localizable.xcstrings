      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من الأيقونة تُظهر خزنتك، وتفتح الوصول السريع، وتقفل Octa Pass أو تُنهيه."
