    "wifi.offerComputer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انضممت إليها للتو. يستطيع Octa Pass قراءة كلمة مرورها من النظام، وقد يسألك النظام أولًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You just joined it. Octa Pass can read its password from the system, which may ask you first."
          }
        }
      }
    },
    "wifi.offerNever" : {
