    "deviceAuth.stayUnlockedPasswordDue" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل كلمة المرور الرئيسية مرة واحدة ليبقى Octa Pass مفتوحًا. يطلبها كل 14 يومًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
