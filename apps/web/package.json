{
  "name": "@octapass/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "The Octa Pass web vault.",
  "scripts": {
    "dev": "vite",
    "dev:stack": "scripts/dev-stack.sh",
    "dev:mock": "VITE_VAULT_BACKEND=mock vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@fontsource/monaspace-neon": "^5.3.0",
    "@octapass/core": "workspace:*",
    "@octapass/ui": "workspace:*",
    "@octapass/vault-client": "workspace:*",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
