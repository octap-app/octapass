    "deviceAuth.appOpen" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدام التحقق بالجهاز عند فتح Octa Pass"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use device auth when Octa Pass opens"
          }
        }
      }
    },
    "deviceAuth.appOpenHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند الإيقاف، يطلب الفتح كلمة المرور الرئيسية بدلًا من ذلك. وللتعبئة إعدادها المستقل أدناه."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off, opening asks for your master password instead. Filling keeps its own setting below."
          }
        }
      }
    },
    "deviceAuth.autofill" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السؤال عند كل تعبئة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask on every fill"
          }
        }
      }
    },
    "deviceAuth.autofillHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم قفل جهازك كل مرة يعبّئ Octa Pass بيانات دخول. عند الإيقاف، تعمل التعبئة مباشرة والخزنة مفتوحة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use your device’s lock each time Octa Pass fills a login. Off, filling works directly while the vault is unlocked."
          }
        }
      }
    },
    "deviceAuth.autofillOff" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لمن يستخدم هذا الجهاز تعبئة بيانات دخولك المحفوظة بلا سؤال والخزنة مفتوحة. لا توقف هذا إلا إذا كنت تقبل ذلك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone who uses this device can fill your saved logins without a prompt while Octa Pass is unlocked. Only turn this off if you accept that."
          }
        }
      }
    },
    "deviceAuth.cvv" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسأل قبل تعبئة رمز الأمان"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask before filling a security code"
          }
        }
      }
    },
    "deviceAuth.cvvHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أكّد هويتك قبل وضع رمز أمان البطاقة (CVV) في الصفحة، حتى لو كانت التعبئة لا تسأل. إذا رفضت، تُعبَّأ بقية بيانات البطاقة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirm it’s you before a card’s security code (CVV) goes into a page, even when filling doesn’t ask. If you say no, the rest of the card is still filled."
          }
        }
      }
    },
    "deviceAuth.localOnly" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه الخزنة موجودة في هذا المتصفح فقط ولا قفل جهاز لاستخدامه. تبقى مفتوحة ما دام Octa Pass يعمل؛ وبعد إعادة التشغيل يطلب الفتح كلمة المرور الرئيسية."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This vault lives only in this browser and has no device lock to use. It stays unlocked while Octa Pass runs; after a restart, opening asks for your master password."
          }
        }
      }
    },
    "deviceAuth.lockless" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا الجهاز بلا قفل يستطيع Octa Pass استخدامه، لذلك لا تسأل عند الفتح أو التعبئة ما دام Octa Pass مفتوحًا. أمّا التصدير وإظهار المفتاح السري فما زالا يحتاجان كلمة المرور الرئيسية."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device has no lock Octa Pass can use, so opening and filling don’t ask while Octa Pass stays unlocked. Exporting and showing your Secret Key still need your master password."
          }
        }
      }
    },
    "deviceAuth.revealHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما دام Octa Pass مفتوحًا، لا يسأل إظهار الأسرار ونسخها. أمّا التصدير وإظهار المفتاح السري وتغيير حسابك فتسأل دائمًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While Octa Pass is unlocked, revealing and copying don’t ask. Exporting, showing your Secret Key and changing your account always ask."
          }
        }
      }
    },
    "deviceAuth.stayUnlocked" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البقاء مفتوحًا ما دمت مسجّل الدخول إلى هذا الجهاز"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stay unlocked while you’re logged in to this device"
          }
        }
      }
    },
    "deviceAuth.stayUnlockedBrowser" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كان تطبيق Octa Pass على هذا الحاسوب يبقى مفتوحًا، تُفتح الإضافة عن طريقه. ومن دون التطبيق يبقى Octa Pass مفتوحًا في هذا المتصفح حتى يُغلق المتصفح."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With the Octa Pass app on this computer staying unlocked, the extension opens through it. Without the app, Octa Pass stays unlocked in this browser until the browser closes."
          }
        }
      }
    },
    "deviceAuth.stayUnlockedGates" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
