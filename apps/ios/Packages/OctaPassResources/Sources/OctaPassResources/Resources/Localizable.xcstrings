    "twoStepSettings.passwordIntro.change" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل كلمة المرور الرئيسية لنقل تسجيل الدخول بخطوتين إلى تطبيق مصادقة جديد. يتوقف التطبيق القديم عن العمل بعد إعداد الجديد."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter your master password to move two-step sign-in to a new authenticator app. The old one stops working once the new one is set up."
          }
        }
