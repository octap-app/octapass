{
  "description": "Change-password save: the report carries the NEW password and form type change-password (no username field on the page)",
  "fields": {
    "#cp-current": "current-password",
    "#cp-new": "new-password",
    "#cp-confirm": "confirm-password"
  },
  "forms": [{ "field": "#cp-current", "type": "change-password" }],
  "saves": [
    {
      "steps": [
        { "type": ["#cp-current", "Old-pass-11"] },
        { "type": ["#cp-new", "Brand-new-pass-77"] },
        { "type": ["#cp-confirm", "Brand-new-pass-77"] },
        { "click": "#save" }
      ],
      "expect": { "username": "", "password": "Brand-new-pass-77", "formType": "change-password" }
    }
  ]
}
