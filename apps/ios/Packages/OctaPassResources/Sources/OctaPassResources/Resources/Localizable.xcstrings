    },
    "import.help.enpass" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في Enpass، اختر File ثم Export ثم ‎.json. لا يمكن نقل المرفقات: أضفها من جديد بعد الاستيراد."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Enpass, choose File → Export → .json. Attachments can’t come across: add them again after the import."
          }
        }
      }
    },
    "import.help.ente-auth" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في Ente Auth، افتح Settings ثم Data ثم Export codes. استورد الملف النصي العادي، أو الملف المشفّر مع كلمة مروره."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Ente Auth, open Settings → Data → Export codes. Import the plain text file, or the encrypted file with its password."
