    "health.email.aliasNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الغرض من البريد المقنّع ألا يُربط بك، وهذا الفحص يربط عناوينك المقنّعة بحسابك لدى خادمك. إن كان هذا يهمك فاتركه متوقفًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An alias’s purpose is that it can’t be tied to you, and this links your aliases to your account for your server. If that matters to you, leave this off."
          }
        }
      }
    },
