    "import.help.chrome" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في متصفحك، افتح مدير كلمات المرور ← الإعدادات ← تصدير كلمات المرور."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In your browser, open Password Manager → Settings → Export passwords."
          }
        }
      }
    },
    "import.help.cxf" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملف تبادل بيانات الاعتماد (CXF) من أي تطبيق يكتب صيغة FIDO القياسية: تسجيلات الدخول ومفاتيح المرور والرموز لمرة واحدة والملاحظات والبطاقات والهويات."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Credential Exchange (CXF) file from any app that writes the FIDO standard format: logins, passkeys, one-time codes, notes, cards and identities."
          }
        }
      }
    },
    "import.help.dashlane" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في Dashlane، افتح Settings ثم Export data، واختر تصدير CSV (ملف ZIP). ملفات JSON تعمل أيضًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Dashlane, go to Settings → Export data, and choose the CSV export (a ZIP file). JSON exports work too."
          }
        }
