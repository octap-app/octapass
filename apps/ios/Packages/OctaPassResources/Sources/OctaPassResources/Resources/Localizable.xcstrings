    "maskedEmail.whereItWorks" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعمل SimpleLogin وaddy.io وFastmail وForward Email في كل مكان. أما Firefox Relay وDuckDuckGo فتعملان في الإضافة والتطبيقات فقط، لأنهما لا تسمحان بالطلبات من صفحات الويب."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SimpleLogin, addy.io, Fastmail and Forward Email work everywhere. Firefox Relay and DuckDuckGo work in the extension and apps only, because they don’t allow calls from web pages."
          }
        }
      }
    },
