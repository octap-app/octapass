---
// The landing page, shared by / and /ar/. Its words are in src/i18n/landing.
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import Site from '../layouts/Site.astro';
import { localePath, stringsFor, type Locale } from '../i18n/landing';
import { isPlatformId, platformLink, REPO_URL, repoFile, repoTree, SITE_NAME, SITE_URL, SOURCE_PATHS, VAULT_URL, type PlatformId } from '../site.config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = stringsFor(locale);
const d = t.demo;
const to = (path: string) => localePath(locale, path);
const { title, description } = t.meta;
const named = (text: string, name: string) => text.replace('{name}', name);

// Each platform item in the strings names a platform in site.config.ts, which holds its store link and source folder.
const platforms = t.platforms.items.map((p) => {
  if (!isPlatformId(p.id)) throw new Error(`Unknown platform id "${p.id}" in src/i18n/landing/${locale}.json`);
  return { ...p, id: p.id as PlatformId, link: platformLink(p.id), source: repoTree(SOURCE_PATHS[p.id]) };
});
const missing = Object.keys(SOURCE_PATHS).filter((id) => !platforms.some((p) => p.id === id));
if (missing.length) throw new Error(`src/i18n/landing/${locale}.json has no platform item for: ${missing.join(', ')}`);

const projectLinks = [
  { href: REPO_URL, label: t.open.repo, icon: 'github', primary: true },
  { href: repoFile('LICENSE'), label: t.open.licence, icon: 'licence' },
  { href: repoFile('CONTRIBUTING.md'), label: t.open.contributing, icon: 'contributing' },
  { href: repoFile('SECURITY.md'), label: t.open.security, icon: 'security' },
  { href: `${REPO_URL}/issues`, label: t.open.issues, icon: 'issues' },
  { href: to('/docs/self-hosting/overview/'), label: t.open.selfHost, icon: 'server' },
] as const;

const sidebar = [
  { label: d.allItems, count: 248, active: true },
  { label: d.favourites, count: 12 },
  { label: d.personal, count: 201 },
  { label: d.family, count: 35, shared: true },
];
const categories = [
  { label: d.logins, count: 186 },
  { label: d.passkeys, count: 23 },
  { label: d.cards, count: 4 },
  { label: d.identities, count: 3 },
  { label: d.notes, count: 32 },
];
const items = [
  { name: 'GitHub', sub: 'maya.rahman@example.com', hue: 222, active: true },
  { name: 'Figma', sub: 'maya@studio.example', hue: 280 },
  { name: 'Netflix', sub: d.familyVault, hue: 2 },
  { name: d.travelCard, sub: d.cardSub, hue: 205 },
  { name: 'Proton Mail', sub: 'maya.r@proton.example', hue: 258 },
  { name: d.homeWifi, sub: 'Rahman-5G', hue: 160 },
  { name: d.passport, sub: d.passportSub, hue: 32 },
  { name: d.awsRoot, sub: d.apiCredential, hue: 40 },
];

// One graph for both language pages: the app, the project behind it and the site, linked by @id.
const pageUrl = new URL(to('/'), SITE_URL).href;
const orgId = new URL('/#organization', SITE_URL).href;
const githubOrg = REPO_URL.replace(/\/[^/]+\/?$/, '');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    '@id': new URL('/#app', SITE_URL).href,
    name: SITE_NAME,
    description,
    url: pageUrl,
    image: new URL('/icon-512.png', SITE_URL).href,
    inLanguage: locale,
    applicationCategory: 'SecurityApplication',
    applicationSubCategory: 'Password manager',
    operatingSystem: 'Web, Windows, macOS, Linux, iOS, iPadOS, Android, Chrome, Edge, Brave, Firefox, Safari',
    downloadUrl: VAULT_URL,
    isAccessibleForFree: true,
    license: 'https://opensource.org/license/mit',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@id': orgId },
    sameAs: [REPO_URL],
    softwareHelp: { '@type': 'CreativeWork', url: new URL(to('/docs/'), SITE_URL).href },
    featureList: 'Passwords, Passkeys, TOTP codes, Autofill, Cards, Identities, Recovery info, Masked email, Security dashboard, Sharing, Import and export',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': orgId,
    name: SITE_NAME,
    url: SITE_URL,
    logo: new URL('/icon-512.png', SITE_URL).href,
    sameAs: [githubOrg, REPO_URL],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': new URL('/#website', SITE_URL).href,
    name: SITE_NAME,
    url: SITE_URL,
    description,
    inLanguage: locale,
    publisher: { '@id': orgId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: locale,
    mainEntity: t.faq.items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---


<Site locale={locale} title={title} description={description} jsonLd={jsonLd} ogImage={`/og/${locale}/home.png`} alternatePath="/" markdownHref={to('/index.md')}>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-copy">
      <Logo id="hero" variant="tile" size={84} class="hero-mark" />
      <h1>{t.hero.title}</h1>
      <p class="hero-sub">{t.hero.sub}</p>
      <div class="hero-actions">
        <a class="pill" href={VAULT_URL}>{t.hero.primary}</a>
        <a class="pill ghost" href={to('/docs/security/overview/')}>{t.hero.secondary}</a>
      </div>
      <p class="hero-status"><span class="dot" aria-hidden="true"></span>{t.hero.status}{' '}<a href="/changelog/">{t.hero.follow}</a></p>
    </div>

    <figure class="shot" aria-label={d.shotLabel}>
      <div class="glow" aria-hidden="true"></div>
      <div class="stage" aria-hidden="true">
        <div class="win">
          <div class="win-bar">
            <span class="lights"><i></i><i></i><i></i></span>
            <span class="win-title">Octa Pass</span>
          </div>
          <div class="win-body">
            <aside class="side">
              <div class="search">{d.search}</div>
              <p class="side-h">{d.vaultsHeading}</p>
              {sidebar.map((s) => (
                <div class:list={['side-row', { on: s.active }]}>
                  <span>{s.label}{s.shared && <em> {d.shared}</em>}</span><b>{s.count}</b>
                </div>
              ))}
              <p class="side-h">{d.categoriesHeading}</p>
              {categories.map((c) => (
                <div class="side-row"><span>{c.label}</span><b>{c.count}</b></div>
              ))}
              <div class="health">
                <svg viewBox="0 0 36 36"><circle cx="18" cy="18" r="15" class="h-track" /><circle cx="18" cy="18" r="15" class="h-fill" pathLength="100" /></svg>
                <span><b>92</b> {d.health}</span>
              </div>
            </aside>
            <div class="list">
              <div class="list-h">{d.allItems}</div>
              {items.map((it) => (
                <div class:list={['row', { on: it.active }]}>
                  <span class="av" style={`--h:${it.hue}`}>{it.name[0]}</span>
                  <span class="row-t"><b>{it.name}</b><small>{it.sub}</small></span>
                </div>
              ))}
            </div>
            <div class="detail">
              <div class="d-head">
                <span class="av big" style="--h:222">G</span>
                <div><b>GitHub</b><small>github.com</small></div>
                <span class="sealed-badge">{d.encrypted}</span>
              </div>
              <div class="d-field"><small>{d.username}</small><span>maya.rahman@example.com</span></div>
              <div class="d-field"><small>{d.password}</small><span class="mono">••••••••••••••••••••</span><i class="copy">{d.copy}</i></div>
              <div class="d-field">
                <small>{d.oneTimeCode}</small>
                <span class="mono code"><span data-totp>––– –––</span><svg class="ring" viewBox="0 0 20 20"><circle cx="10" cy="10" r="8" pathLength="30" data-ring /></svg></span>
              </div>
              <div class="d-field"><small>{d.passkey}</small><span>{d.passkeySaved}</span></div>
              <div class="d-field"><small>{d.recovery}</small><span>{d.recoverySub}</span></div>
              <div class="tags"><i>{d.tagWork}</i><i>{d.tagDeveloper}</i></div>
            </div>
          </div>
        </div>

        <div class="phone">
          <div class="screen">
            <div class="status"><b>9:41</b><span></span></div>
            <div class="site">
              <div class="site-logo"></div>
              <p>{d.phoneSignIn}</p>
              <div class="site-field"></div>
              <div class="site-field"></div>
              <div class="site-btn"></div>
            </div>
            <div class="sheet">
              <div class="sheet-top"><Logo id="phone" variant="tile" size={22} /><span>Octa Pass</span></div>
              <p class="sheet-q">{d.phoneQuestion}</p>
              <div class="sheet-acct"><span class="av sm" style="--h:222">M</span><span>maya.rahman<small>{d.passkey}</small></span></div>
              <svg class="faceid" viewBox="0 0 48 48"><path d="M4 14V9a5 5 0 0 1 5-5h5M34 4h5a5 5 0 0 1 5 5v5M44 34v5a5 5 0 0 1-5 5h-5M14 44H9a5 5 0 0 1-5-5v-5M17 17v4M31 17v4M24 17v9h-2M17 32s2.5 3 7 3 7-3 7-3" /></svg>
              <div class="sheet-btn">{d.continue}</div>
            </div>
          </div>
        </div>
      </div>
    </figure>
  </section>

  <!-- Statement: the live encryption demo -->
  <section class="night statement" aria-labelledby="statement-title">
    <div class="wrap center">
      <h2 id="statement-title" class="gradient-text">{t.statement.titleLine1}<br />{t.statement.titleLine2}</h2>
      <p class="lead">{t.statement.lead}</p>
    </div>
    <figure class="vault" aria-labelledby="vault-caption">
      <div class="seg" role="tablist" aria-label={t.statement.tabsLabel}>
        <button role="tab" id="tab-device" aria-selected="true" aria-controls="panel-device">{t.statement.tabDevice}</button>
        <button role="tab" id="tab-server" aria-selected="false" aria-controls="panel-server" tabindex="-1">{t.statement.tabServer}</button>
      </div>
      <div class="vault-panel" role="tabpanel" id="panel-device" aria-labelledby="tab-device">
        <dl>
          <div><dt>{t.statement.website}</dt><dd>github.com</dd></div>
          <div><dt>{d.username}</dt><dd>maya.rahman@example.com</dd></div>
          <div><dt>{d.password}</dt><dd class="mono">Lantern-ruby-T7#qv-42</dd></div>
          <div><dt>{d.oneTimeCode}</dt><dd class="mono"><span data-totp>––– –––</span></dd></div>
          <div><dt>{d.passkey}</dt><dd>{t.statement.passkeyValue}</dd></div>
        </dl>
      </div>
      <div class="vault-panel" role="tabpanel" id="panel-server" aria-labelledby="tab-server" hidden>
        <dl class="server">
          <div><dt>id</dt><dd class="mono">itm_7f3c9a1e52b84d60</dd></div>
          <div><dt>revision</dt><dd class="mono">41</dd></div>
          <div><dt>item_key</dt><dd class="mono cipher" data-cipher="key">AXnq0v3Kc2HcWmZ8yN1pQe7rT4uB0aLsFgD9kJ5xVhR6oI2tYwE</dd></div>
          <div><dt>overview</dt><dd class="mono cipher" data-cipher="overview">AQtR8pW3mZ0yLc5vN2bXh7KdF4sJ9gE1aU6oTqYi3rVwHn8eMx</dd></div>
          <div><dt>details</dt><dd class="mono cipher" data-cipher="details">AWk2fH9sQ4zR7xLm1cV8bN3pT6yG0dJ5aE2uKoWi9tYhSr4nMe</dd></div>
        </dl>
      </div>
      <figcaption id="vault-caption" data-caption={t.statement.captionLive}>{t.statement.caption}</figcaption>
    </figure>
  </section>

  <!-- Bento -->
  <section class="bento-section" aria-labelledby="bento-title">
    <div class="wrap">
      <h2 id="bento-title" class="section-title">{t.bento.titleLine1}<br /><span class="soft">{t.bento.titleLine2}</span></h2>
      <div class="bento">
        <article class="tile t-passkey">
          <div class="tile-copy">
            <h3>{t.bento.passkeysTitle}</h3>
            <p>{t.bento.passkeysBody}</p>
          </div>
          <div class="pk-visual" aria-hidden="true">
            <svg class="pk-face" viewBox="0 0 48 48"><path d="M4 14V9a5 5 0 0 1 5-5h5M34 4h5a5 5 0 0 1 5 5v5M44 34v5a5 5 0 0 1-5 5h-5M14 44H9a5 5 0 0 1-5-5v-5M17 17v4M31 17v4M24 17v9h-2M17 32s2.5 3 7 3 7-3 7-3" /></svg>
            <div class="pk-chip"><b>github.com</b><span>maya.rahman</span></div>
          </div>
        </article>

        <article class="tile t-otp">
          <h3>{t.bento.otpTitle}</h3>
          <p class="otp-big mono"><span data-totp>––– –––</span></p>
          <p>{t.bento.otpBody}</p>
        </article>

        <article class="tile t-fill">
          <h3>{t.bento.fillTitle}</h3>
          <div class="fill-visual" aria-hidden="true">
            <div class="fill-input">{t.bento.fillEmail}</div>
            <div class="fill-pop"><span class="av sm" style="--h:222">G</span><span>maya.rahman@example.com<small>GitHub</small></span></div>
          </div>
          <p>{t.bento.fillBody}</p>
        </article>

        <article class="tile t-health">
          <div class="health-big" aria-hidden="true">
            <svg viewBox="0 0 36 36"><defs><linearGradient id="hg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#2456f0" /><stop offset="1" stop-color="#10b77f" /></linearGradient></defs><circle cx="18" cy="18" r="15" class="h-track" /><circle cx="18" cy="18" r="15" class="h-fill g" pathLength="100" /></svg>
            <b>92</b>
          </div>
          <h3>{t.bento.breachTitle}</h3>
          <p>{t.bento.breachBody} <a href={to('/docs/security/breach-checks/')}>{t.bento.breachLink}</a></p>
        </article>

        <article class="tile t-alias">
          <h3>{t.bento.aliasTitle}</h3>
          <p class="alias mono">gh-k7x2@alias.example</p>
          <p>{t.bento.aliasBody}</p>
        </article>

        <article class="tile t-recovery">
          <div class="tile-copy">
            <h3>{t.bento.recoveryTitle}</h3>
            <p>{t.bento.recoveryBody}</p>
          </div>
          <svg class="rec-map" viewBox="0 0 420 180" aria-hidden="true">
            <g class="rec-lines">
              <path d="M210 90 C150 90 120 30 60 30" /><path d="M210 90 C150 90 120 150 60 150" />
              <path d="M210 90 C270 90 300 30 360 30" /><path d="M210 90 C270 90 300 150 360 150" />
              <path d="M210 90 H60" /><path d="M210 90 H360" />
            </g>
            <g class="rec-nodes">
              <rect x="20" y="16" width="80" height="28" rx="14" /><text x="60" y="35">GitHub</text>
              <rect x="20" y="76" width="80" height="28" rx="14" /><text x="60" y="95">Figma</text>
              <rect x="20" y="136" width="80" height="28" rx="14" /><text x="60" y="155">{t.bento.bank}</text>
              <rect x="320" y="16" width="80" height="28" rx="14" /><text x="360" y="35">Netflix</text>
              <rect x="320" y="76" width="80" height="28" rx="14" /><text x="360" y="95">Apple ID</text>
              <rect x="320" y="136" width="80" height="28" rx="14" /><text x="360" y="155">AWS</text>
            </g>
            <rect class="rec-hub" x="130" y="72" width="160" height="36" rx="18" /><text class="rec-hub-t" x="210" y="95">maya.rahman@…</text>
          </svg>
        </article>

        <article class="tile t-card">
          <div class="card-visual" aria-hidden="true">
            <span class="chip"></span><span class="mono">•••• 4242</span><small>MAYA RAHMAN</small>
          </div>
          <h3>{t.bento.cardsTitle}</h3>
          <p>{t.bento.cardsBody}</p>
        </article>

        <article class="tile t-import">
          <h3>{t.bento.importTitle}</h3>
          <p class="import-list" aria-label={t.bento.importLabel}>1Password Bitwarden LastPass Chrome Safari Firefox Proton&nbsp;Pass Dashlane KeePass {t.bento.importAuthenticators}</p>
          <p>{t.bento.importBody}</p>
        </article>
      </div>
    </div>
  </section>


  <!-- The free hosted service -->
  <section class="free" id="free" aria-labelledby="free-title">
    <div class="wrap">
      <h2 id="free-title" class="section-title">{t.free.titleLine1}<br /><span class="soft">{t.free.titleLine2}</span></h2>
      <div class="free-grid">
        <div class="plan">
          <div class="plan-head">
            <Logo id="plan" variant="tile" size={48} />
            <div>
              <h3>Octa Pass</h3>
              <p class="price"><b>$0</b> {t.free.forever}</p>
            </div>
          </div>
          <ul class="plan-list">
            {t.free.features.map((f) => <li>{f}</li>)}
          </ul>
          <p class="plan-note">{t.free.note}</p>
        </div>
        <div class="how-free">
          <h3>{t.free.howTitle}</h3>
          <p set:html={t.free.howTiny} />
          <p set:html={t.free.howNoAds} />
          <p set:html={t.free.howFunded} />
        </div>
      </div>
    </div>
  </section>

  <!-- How it's sealed -->
  <section class="sealed" aria-labelledby="sealed-title">
    <div class="wrap">
      <h2 id="sealed-title" class="section-title">{t.sealed.title}</h2>
      <ol class="steps">
        {t.sealed.steps.map((s, i) => (
          <li>
            <span class="step-n">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
      <div class="sees">
        <div>
          <h3>{t.sealed.seesTitle}</h3>
          <ul>{t.sealed.sees.map((s) => <li>{s}</li>)}</ul>
        </div>
        <div class="never">
          <h3>{t.sealed.neverTitle}</h3>
          <ul>{t.sealed.never.map((s) => <li>{s}</li>)}</ul>
        </div>
      </div>
      <p class="more"><a href={to('/docs/security/what-the-server-sees/')}>{t.sealed.more}</a></p>
    </div>
  </section>

  <!-- Platforms -->
  <section class="platforms" aria-labelledby="platforms-title">
    <div class="wrap">
      <h2 id="platforms-title" class="section-title">{t.platforms.title}</h2>
      <p class="section-lede">{t.platforms.lede}</p>
      <ul class="plat-grid">
        {platforms.map((p) => (
          <li>
            <svg class="plat-icon" viewBox="0 0 32 32" aria-hidden="true">
              {p.icon === 'browser' && <><rect x="3" y="6" width="26" height="20" rx="3" /><path d="M3 11h26" /></>}
              {p.icon === 'laptop' && <><rect x="6" y="7" width="20" height="14" rx="2" /><path d="M3 25h26" /></>}
              {p.icon === 'desktop' && <><rect x="3" y="5" width="26" height="17" rx="2" /><path d="M12 27h8M16 22v5" /></>}
              {p.icon === 'phone' && <><rect x="9" y="3" width="14" height="26" rx="3" /><path d="M14 25h4" /></>}
              {p.icon === 'terminal' && <><rect x="3" y="6" width="26" height="20" rx="3" /><path d="M8 13l4 3-4 3M15 20h7" /></>}
              {p.icon === 'globe' && <><circle cx="16" cy="16" r="12" /><ellipse cx="16" cy="16" rx="5" ry="12" /><path d="M4 16h24" /></>}
              {p.icon === 'code' && <><rect x="3" y="6" width="26" height="20" rx="3" /><path d="M12 12l-4 4 4 4M20 12l4 4-4 4" /></>}
            </svg>
            <h3>{p.name}</h3>
            <p>{p.detail}</p>
            <div class="plat-foot">
              {p.link?.kind === 'open' && <a class="plat-get now" href={p.link.href}>{t.platforms.openVault}</a>}
              {p.link?.kind === 'store' && <a class="plat-get" href={p.link.href} aria-label={named(t.platforms.getLabel, p.name)}>{t.platforms.getIt}</a>}
              {!p.link && <span class="soon">{t.platforms.soon}</span>}
              <a class="plat-src" href={p.source} aria-label={named(t.platforms.sourceLabel, p.name)}><Icon name="code" size={14} />{t.platforms.source}</a>
            </div>
          </li>
        ))}
      </ul>
      <p class="more"><a href={to('/docs/platforms/support-matrix/')}>{t.platforms.more}</a></p>
    </div>
  </section>

  <!-- Open source -->
  <section class="night open" aria-labelledby="open-title">
    <div class="open-glow" aria-hidden="true"></div>
    <div class="wrap open-grid">
      <div>
        <h2 id="open-title" class="section-title">{t.open.titleLine1}<br /><span class="gradient-text">{t.open.titleLine2}</span></h2>
        <div class="open-points">
          <p set:html={t.open.code} />
          <p set:html={t.open.server} />
          <p set:html={t.open.noAds} />
        </div>
        <nav class="open-links" aria-label={t.open.linksLabel}>
          <ul>
            {projectLinks.map((l) => (
              <li><a class:list={{ primary: 'primary' in l }} href={l.href}><Icon name={l.icon} />{l.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
      <figure class="term" dir="ltr">
        <div class="term-bar"><span class="lights"><i></i><i></i><i></i></span><span>{t.open.terminal}</span></div>
        <pre><code><span class="prompt">$</span> docker build -f apps/server/Dockerfile -t octapass-server .
<span class="prompt">$</span> docker run -d -p 8080:8080 \
    -v octapass-data:/data \
    -e OCTAPASS_PUBLIC_URL=https://vault.example.com \
    octapass-server</code></pre>
        <figcaption dir={locale === 'ar' ? 'rtl' : 'ltr'}><a href={to('/docs/self-hosting/connect-apps/')}>{t.open.connect}</a></figcaption>
      </figure>
    </div>
  </section>

  <!-- Roadmap -->
  <section class="roadmap" aria-labelledby="roadmap-title">
    <div class="wrap">
      <h2 id="roadmap-title" class="section-title">{t.roadmap.title}</h2>
      <ol class="track">
        {t.roadmap.phases.map((p) => (
          <li class={p.step} aria-current={p.step === 'now' ? 'step' : undefined}>
            <span class="node" aria-hidden="true"></span>
            <span class="track-n">{p.state}</span>
            <span class="track-t">{p.title}</span>
          </li>
        ))}
      </ol>
