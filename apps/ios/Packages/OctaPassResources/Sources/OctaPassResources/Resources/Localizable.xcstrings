    "health.email.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرف متى يظهر بريد حسابك أو عناوين البريد المقنّع في اختراق بيانات. خلافًا لكل فحص آخر هنا، يرسل هذا الفحص عناوين خارج جهازك، لذا يبقى متوقفًا حتى تشغّله."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find out when your account email or masked email aliases appear in a data breach. Unlike every other check here, this one sends addresses off your device, so it’s off until you turn it on."
          }
        }
      }
    },
    "health.email.new" : {
