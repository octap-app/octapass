    "fileTools.storage.copyOnWrite" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعتمد هذا القرص النسخ عند الكتابة: تذهب الكتابة الجديدة إلى كتل أخرى، وتبقى القديمة حتى يُعاد استخدامها، وتحتفظ بها اللقطات مدة أطول. تشفير القرص بالكامل هو ما يحميها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This drive is copy-on-write: the overwrite goes to new blocks, and the old ones stay until they’re reused. Snapshots keep them longer. Full-disk encryption is what protects them."
          }
        }
      }
    },
    "fileTools.storage.inPlaceDisk" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يكتب هذا القرص فوق البيانات في مكانها، فستُستبدل الكتل الأصلية. لا يشمل ذلك النسخ الاحتياطية واللقطات."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This drive overwrites in place, so the original blocks will be overwritten. Backups and snapshots aren’t touched."
          }
        }
      }
    },
    "fileTools.storage.network" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا مجلد شبكة أو سحابة. يحتفظ خادمه ونسخه الاحتياطية بنسخ خاصة لا يصل إليها Octa Pass."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is a network or cloud folder. Its server and backups keep their own copies, which Octa Pass can’t reach."
          }
        }
      }
    },
    "fileTools.storage.solidState" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا قرص SSD. ينقل الكتابة بين خلاياه، فقد تبقى نسخ قديمة في خلايا لا يمكن الوصول إليها. تشفير القرص بالكامل هو ما يحميها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is an SSD. It moves writes around, so old copies can stay in cells nothing can reach. Full-disk encryption is what protects them."
          }
        }
      }
    },
    "fileTools.storage.unknown" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع Octa Pass معرفة طريقة تخزين هذا القرص للبيانات، فافترض أن نسخًا قديمة قد تبقى عليه. تشفير القرص بالكامل هو ما يحميها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Octa Pass can’t tell how this drive stores data, so assume old copies can stay on it. Full-disk encryption is what protects them."
          }
        }
      }
    },
    "fileTools.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شفّر الملفات والمجلدات بصيغة age ليفتحها من تختارهم فقط. تبقى المجلدات على هذا الكمبيوتر ما لم تشغّل المزامنة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encrypt files and folders in the age format, so only the people you choose can open them. Folders stay on this computer unless you turn on sync."
          }
        }
      }
