    "fingerprint.compareHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطلب من %1$@ أن يقرأ بصمة المفتاح المعروضة في صفحة المشاركة لديه، وجهًا لوجه أو في مكالمة. إذا تطابقت، فلم يبدّل أحد مفاتيحه في الطريق."
