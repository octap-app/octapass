      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وأيضًا إعادة تعيين كلمة المرور الرئيسية، عندما تدعم التطبيقات ذلك. حتى ذلك الحين يعمل مثل «عرض»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Also reset your master password, once the apps support it. Until then it works like View."
          }
        }
      }
    },
    "emergency.takeoverWarning" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتمكن هذا الشخص من استبدال كلمة مرورك الرئيسية بعد انتهاء فترة الانتظار. سيُسجَّل خروجك من كل مكان، ويتوقف تسجيل الدخول بخطوتين. لا تختر إلا من تثق به على كل ما في حسابك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This person will be able to replace your master password once the waiting period ends. You’d be signed out everywhere, and two-step sign-in would be turned off. Only choose someone you’d trust with everything in your account."
          }
        }
      }
    },
