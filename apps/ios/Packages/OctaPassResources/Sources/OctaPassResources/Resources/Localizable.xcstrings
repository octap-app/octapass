    "vault.untrustedBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يجتز مفتاح %1$@ فحص التوقيع، لذلك لن يفتحها Octa Pass. ستبقى عناصرها مخفية حتى يضيفك الشخص الذي شاركها معك من جديد. إذا تكرر ذلك فأخبره: قد يكون هناك من يعبث بالخادم."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The key for %1$@ didn’t pass its signature check, so Octa Pass won’t open it. Its items stay hidden until the person who shared it adds you again. If it keeps happening, tell them: someone may be interfering with the server."
          }
        }
      }
    },
    "vaultKeys.action" : {
