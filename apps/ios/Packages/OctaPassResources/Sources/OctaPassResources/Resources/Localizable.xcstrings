    "wifi.offerPhone" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت متصل بها، وهي ليست في خزنتك. اكتب كلمة مرورها مرة واحدة لتبقى مع شبكاتك الأخرى."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You’re connected to it, and it isn’t in your vault. Type its password once to keep it with your other networks."
          }
        }
      }
    },
