    "wifi.iosImport" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يسمح iPhone للتطبيقات بقراءة شبكات Wi-Fi المحفوظة عليه. لإضافة شبكة اكتبها بنفسك، أو امسح رمز QR الخاص بها عبر «مسح رمز QR»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone doesn’t let apps read the Wi-Fi networks it has saved. To add one, type it in, or scan the network’s QR code with Scan a QR code."
          }
        }
      }
    },
    "wifi.managed" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تديرها مؤسسة"
