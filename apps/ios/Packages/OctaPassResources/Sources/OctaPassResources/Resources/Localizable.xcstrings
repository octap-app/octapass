{
  "sourceLanguage" : "en",
  "strings" : {
    "background.failed" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على Octa Pass ذلك: %1$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Octa Pass couldn’t do this: %1$@"
          }
        }
      }
    },
    "background.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إغلاق النافذة لا يُنهي Octa Pass، فيستمر عمل الوصول السريع وإضافة المتصفح ووكيل SSH. هذه الإعدادات لهذا الحاسوب فقط."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Closing the window doesn’t quit Octa Pass, so quick access, the browser extension and the SSH agent keep working. These settings are for this computer only."
          }
        }
      }
    },
    "background.menuBar" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إظهار الأيقونة في شريط القائمة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show in the menu bar"
          }
        }
      }
    },
    "background.notInstalled" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لتشغيل هذا الخيار، انقل Octa Pass إلى مجلد التطبيقات وافتحه من هناك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To turn this on, move Octa Pass to your Applications folder and open it from there."
          }
        }
      }
    },
