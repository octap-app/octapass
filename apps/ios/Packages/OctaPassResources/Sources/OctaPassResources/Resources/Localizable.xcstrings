    "changePassword.signsOut" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُسجَّل خروج أجهزتك الأخرى. سجّل الدخول عليها بكلمة المرور الجديدة، وشغّل فتح القفل بالجهاز من جديد."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your other devices will be signed out. Sign in on them with the new password; device unlock needs turning on again."
          }
        }
      }
    },
