{
  "name": "@octapass/extension",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "The Octa Pass browser extension for Chrome, Edge and Firefox (Manifest V3).",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.ts",
    "dev": "node scripts/build.ts --watch",
    "icons": "node scripts/icons.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "test:server": "vitest run --config vitest.server.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@fontsource/monaspace-neon": "^5.3.0",
    "@octapass/autofill": "workspace:*",
    "@octapass/core": "workspace:*",
    "@octapass/ui": "workspace:*",
    "@octapass/vault-client": "workspace:*",
    "@octapass/web": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/chrome": "^0.3.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
