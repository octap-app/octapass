<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The AutoFill extension: sandboxed, with the app's App Group (the store) and Keychain group (the
     Secret Key, the device-unlock and stay-unlocked keys). The provider entitlement is what lets
     macOS turn it on in System Settings; Apple grants it only in a provisioning profile
     (OCTAPASS_MAC_AUTOFILL in ../Signing.xcconfig). -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.authentication-services.autofill-credential-provider</key>
	<true/>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(OCTAPASS_APP_GROUP)</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(OCTAPASS_KEYCHAIN_GROUP)</string>
	</array>
</dict>
</plist>
