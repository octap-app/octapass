    "members.removeBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيفقد الوصول فورًا. بعدها يعطي Octa Pass %1$@ مفتاحًا جديدًا، فلا يعود أي شيء احتفظ به صالحًا. ربما نسخ العناصر التي رآها من قبل، لذلك غيّر كلمات المرور المهمة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They lose access straight away. Octa Pass then gives %1$@ a new key, so anything they kept stops working. Items they saw before may already be copied, so change important passwords."
          }
        }
      }
    },
