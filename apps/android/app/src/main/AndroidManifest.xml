<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The QR scanner and "Take a photo"; codes are read on the phone and never sent anywhere. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- Wi-Fi: the name of the network the phone is on and of those in range, for the
         "Connected" and "In range" marks. Android gives them only with location access, which is
         asked for when the user opens Wi-Fi; Octa Pass never reads the location itself. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Writing a Wi-Fi network to an NFC tag, when the user asks and confirms; the app reads no
         tags. Phones without NFC just don't offer it. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <!-- The one notification Octa Pass posts: "something changed in your sharing or emergency
         access", when a push says so (platform/Push.kt). Asked for once, after the first unlock. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- No backups: the Keystore keys that open the stored secrets never leave this phone. -->
    <application
        android:name=".OctaPassApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OctaPass"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- One-time code setup links from websites, QR codes and Google Authenticator's
                 export. Nothing is saved before the user confirms it on screen. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="otpauth" />
                <data android:scheme="otpauth-migration" />
            </intent-filter>
        </activity>

        <!-- A Wear OS watch asking for one-time codes. Bound by Google Play services, which delivers
             only what the same app, with the same signing key, sends. -->
        <service
            android:name=".platform.WatchRequests"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/octapass/watch" />
            </intent-filter>
        </service>

        <!-- Push sync (platform/Push.kt). Data messages that carry only their kind ("sync" or
             "alert"); the app syncs and, for an alert, posts its own generic notification. -->
        <service
            android:name=".platform.PushMessages"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Firebase is started by hand, and only in builds given a Firebase project (PushLink),
             so its provider that would start it at launch from google-services.json is removed. -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />
        <!-- Nothing reports anything: no token until PushLink asks for one, Analytics off (it
             isn't in the app either), and no delivery metrics to Google's BigQuery export. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_analytics_collection_deactivated"
            android:value="true" />
        <meta-data
            android:name="delivery_metrics_exported_to_big_query_enabled"
            android:value="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Open Safes in the Files app and document pickers. Only the system's document UI can
             call it; with the vault locked it has no roots and nothing to read with. -->
        <provider
            android:name=".platform.SafeDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
