{
  "name": "@octapass/vault-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "The Octa Pass item model, the VaultService interface, local tools, the real service on the WASM core and a mock for UI development.",
  "exports": {
    ".": "./src/index.ts",
    "./mock": "./src/mock/index.ts",
    "./remote": "./src/remote/index.ts",
    "./remote/worker": "./src/remote/worker.ts",
    "./testing": "./src/mock/fakeAuthenticator.ts",
    "./remote/testing/server": "./src/remote/testing/server.ts",
    "./remote/testing/devices": "./src/remote/testing/devices.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:server": "vitest run --config vitest.server.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@octapass/core": "workspace:*"
  }
}
