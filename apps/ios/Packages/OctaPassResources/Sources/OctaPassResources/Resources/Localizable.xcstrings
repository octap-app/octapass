    "family.recovery.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إن فقدت كلمة مرورك ومفتاحك السري ورمز الاسترداد، يستطيع %1$@ إعادة تعيين حسابك بعد فترة انتظار تختارها. وهذا متوقف ما لم تشغّله."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you lose your password, your Secret Key and your recovery code, %1$@ could reset your account after a waiting period you choose. Off unless you turn it on."
          }
        }
      }
    },
