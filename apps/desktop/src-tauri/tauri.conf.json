{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Octa Pass",
  "mainBinaryName": "octapass-desktop",
  "version": "0.1.0",
  "identifier": "app.octap.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && pnpm build:host",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Octa Pass",
        "url": "index.html",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "visible": false
      },
      {
        "label": "quick",
        "title": "Quick access",
        "url": "quick.html",
        "width": 560,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "copyright": "Octa Pass contributors, MIT",
    "shortDescription": "An open-source, end-to-end encrypted password manager.",
    "targets": ["deb", "rpm", "appimage", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "linux": {
      "deb": {
        "files": {
          "/usr/bin/octapass-native-host": "binaries/octapass-native-host",
          "/usr/bin/octapass": "binaries/octapass",
          "/usr/bin/git-credential-octapass": "binaries/git-credential-octapass",
          "/usr/bin/octapass-git-sign": "binaries/octapass-git-sign",
          "/usr/bin/docker-credential-octapass": "binaries/docker-credential-octapass",
          "/usr/share/polkit-1/actions/app.octap.desktop.policy": "linux/app.octap.desktop.policy"
        }
      },
      "rpm": {
        "files": {
          "/usr/bin/octapass-native-host": "binaries/octapass-native-host",
          "/usr/bin/octapass": "binaries/octapass",
          "/usr/bin/git-credential-octapass": "binaries/git-credential-octapass",
          "/usr/bin/octapass-git-sign": "binaries/octapass-git-sign",
          "/usr/bin/docker-credential-octapass": "binaries/docker-credential-octapass",
          "/usr/share/polkit-1/actions/app.octap.desktop.policy": "linux/app.octap.desktop.policy"
        }
      }
    }
  }
}
