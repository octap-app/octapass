    },
    "wifi.permissionBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يخبر جهازك التطبيقات بأسماء شبكات Wi-Fi إلا بإذن الوصول إلى الموقع. يستخدمه Octa Pass ليميّز الشبكة المتصل بها والشبكات التي في النطاق، ولا يستخدمه أبدًا لمعرفة مكانك. لا يغادر شيء هذا الجهاز."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your device tells apps the names of Wi-Fi networks only with location access. Octa Pass uses it to mark the network you’re on and the ones in range, never to find where you are. Nothing leaves this device."
          }
        }
      }
    },
    "wifi.permissionBodyCurrent" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يخبر iPhone التطبيقات باسم شبكة Wi-Fi المتصل بها إلا بإذن الوصول إلى الموقع. يستخدمه Octa Pass ليميّز تلك الشبكة، ولا يستخدمه أبدًا لمعرفة مكانك. لا يغادر شيء هذا الجهاز."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your iPhone tells apps the name of the Wi-Fi network it’s on only with location access. Octa Pass uses it to mark that network, never to find where you are. Nothing leaves this device."
          }
        }
      }
    },
    "wifi.permissionDenied" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوصول إلى الموقع متوقف لـ Octa Pass، فلا يستطيع رؤية أسماء الشبكات. شغّله من إعدادات جهازك ليميّز الشبكة المتصل بها والشبكات القريبة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location access is off for Octa Pass, so it can’t see network names. Turn it on in your device’s settings to mark the networks you’re on and near."
