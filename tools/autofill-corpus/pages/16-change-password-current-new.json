{
  "description": "Change password with only current + new, side by side, labels only",
  "fields": {
    "#old_pass": "current-password",
    "#new_pass": "new-password"
  },
  "forms": [{ "field": "#old_pass", "type": "change-password" }],
  "fills": [
    {
      "focus": "#old_pass",
      "pick": "login",
      "expect": { "#old_pass": "correct-horse-42!", "#new_pass": "" }
    },
    {
      "focus": "#new_pass",
      "pick": "generated-password",
      "expect": { "#old_pass": "", "#new_pass": "Lantern-ruby-T7#qv-42" }
    }
  ]
}
