    "vaultKeys.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنتقل كل عناصر الخزنة إلى مفتاح جديد. تبقى عناصرك وملفاتك وأعضاؤك كما هم، وتحصل أجهزتك الأخرى على المفتاح الجديد تلقائيًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every item in the vault moves to a new key. Your items, files and members stay as they are, and your other devices pick up the new key by themselves."
          }
        }
      }
    },
    "vaultKeys.limits" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا يحميك ممن لا يملك سوى المفتاح القديم. أما كلمات المرور التي قرأها من قبل فقد صار يعرفها، فغيّر المهم منها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This protects against someone who has only the old key. Passwords they already read are still known to them, so change the ones that matter."
          }
        }
      }
    },
