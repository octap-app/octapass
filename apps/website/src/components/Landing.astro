<script>
  // Live, real data in the demo: RFC 6238 codes for a demo secret, and ciphertext made in the browser.
  const enc = new TextEncoder();
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const b64url = (bytes: Uint8Array) =>
    btoa(String.fromCharCode(...bytes)).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');

  async function seal(key: CryptoKey, plaintext: string) {
    const iv = crypto.getRandomValues(new Uint8Array(12));
    const ct = new Uint8Array(await crypto.subtle.encrypt({ name: 'AES-GCM', iv }, key, enc.encode(plaintext)));
    const out = new Uint8Array(1 + iv.length + ct.length);
    out.set([1]);
    out.set(iv, 1);
    out.set(ct, 1 + iv.length);
    return b64url(out);
  }

  async function fillCiphertext() {
    if (!crypto?.subtle) return;
    const itemKey = await crypto.subtle.generateKey({ name: 'AES-GCM', length: 256 }, true, ['encrypt']);
    const vaultKey = await crypto.subtle.generateKey({ name: 'AES-GCM', length: 256 }, false, ['encrypt']);
    const rawItemKey = b64url(new Uint8Array(await crypto.subtle.exportKey('raw', itemKey)));
    const values: Record<string, string> = {
      key: await seal(vaultKey, rawItemKey),
      overview: await seal(itemKey, JSON.stringify({ title: 'GitHub', urls: ['https://github.com'] })),
      details: await seal(
        itemKey,
        JSON.stringify({
          username: 'maya.rahman@example.com',
          password: 'Lantern-ruby-T7#qv-42',
          totp: 'otpauth://totp/GitHub?secret=JBSWY3DPEHPK3PXP',
          passkey: { rpId: 'github.com', created: '2026-10-12' },
        }),
      ),
    };
    document.querySelectorAll<HTMLElement>('[data-cipher]').forEach((el) => {
      el.dataset.value = values[el.dataset.cipher!];
      el.textContent = values[el.dataset.cipher!];
    });
    // The finished sentence is on the element, in the page's language.
    const caption = document.querySelector<HTMLElement>('[data-caption]');
    if (caption?.dataset.caption) caption.textContent = caption.dataset.caption;
  }

  function scramble(el: HTMLElement) {
    const target = el.dataset.value ?? el.textContent ?? '';
    if (reduceMotion) return;
    const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_';
    const start = performance.now();
    const frame = (now: number) => {
      const settled = Math.floor(((now - start) / 650) * target.length);
      let text = target.slice(0, settled);
      for (let i = settled; i < target.length; i++) text += alphabet[(Math.random() * alphabet.length) | 0];
      el.textContent = text;
      if (settled < target.length) requestAnimationFrame(frame);
      else el.textContent = target;
    };
    requestAnimationFrame(frame);
  }

  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.vault [role="tab"]'));
  function select(tab: HTMLButtonElement) {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    }
    document.querySelector('.seg')?.setAttribute('data-active', tab.id);
    if (tab.id === 'tab-server') document.querySelectorAll<HTMLElement>('[data-cipher]').forEach(scramble);
  }
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      // Tabs run right to left on Arabic pages, so the arrows swap with them.
      const forward = e.key === (document.documentElement.dir === 'rtl' ? 'ArrowLeft' : 'ArrowRight');
      const next = tabs[(i + (forward ? 1 : tabs.length - 1)) % tabs.length];
      next.focus();
      select(next);
    });
  });

  // The one scroll moment: when the demo comes into view, seal the login once.
  const vault = document.querySelector('.vault');
  if (vault && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        setTimeout(() => select(tabs[1]), 1100);
      },
      { threshold: 0.65 },
    );
    io.observe(vault);
  }

  function base32Decode(input: string) {
    const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';
    let bits = '';
    for (const c of input.replace(/=+$/, '')) bits += alphabet.indexOf(c).toString(2).padStart(5, '0');
    const bytes = new Uint8Array(Math.floor(bits.length / 8));
    for (let i = 0; i < bytes.length; i++) bytes[i] = parseInt(bits.slice(i * 8, i * 8 + 8), 2);
    return bytes;
  }

  async function totp(secret: string, step = 30) {
    const counter = Math.floor(Date.now() / 1000 / step);
    const msg = new DataView(new ArrayBuffer(8));
    msg.setUint32(4, counter);
    msg.setUint32(0, Math.floor(counter / 2 ** 32));
    const key = await crypto.subtle.importKey('raw', base32Decode(secret), { name: 'HMAC', hash: 'SHA-1' }, false, ['sign']);
    const mac = new Uint8Array(await crypto.subtle.sign('HMAC', key, msg.buffer));
    const offset = mac[mac.length - 1] & 0xf;
    const code =
      (((mac[offset] & 0x7f) << 24) | (mac[offset + 1] << 16) | (mac[offset + 2] << 8) | mac[offset + 3]) % 1_000_000;
    return code.toString().padStart(6, '0');
  }

  async function tick() {
    if (!crypto?.subtle) return;
    const code = await totp('JBSWY3DPEHPK3PXP');
    const remaining = 30 - (Math.floor(Date.now() / 1000) % 30);
    document.querySelectorAll<HTMLElement>('[data-totp]').forEach((el) => {
      el.textContent = `${code.slice(0, 3)} ${code.slice(3)}`;
    });
    document.querySelectorAll<SVGCircleElement>('[data-ring]').forEach((ring) => {
      ring.style.setProperty('stroke-dashoffset', String(30 - remaining));
    });
  }

  fillCiphertext();
  tick();
  setInterval(tick, 1000);
</script>

