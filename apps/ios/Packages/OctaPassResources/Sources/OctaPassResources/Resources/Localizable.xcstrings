    "export.cxfHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صيغة FIDO لتبادل بيانات الاعتماد، للانتقال إلى تطبيق آخر يدعمها: تسجيلات الدخول ومفاتيح المرور والرموز لمرة واحدة والملاحظات والبطاقات والهويات. سجل كلمات المرور ومعلومات الاسترداد والملفات لا تنتقل."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The FIDO Credential Exchange Format, for moving to another app that supports it: logins, passkeys, one-time codes, notes, cards and identities. Password history, recovery info and files stay behind."
          }
        }
      }
    },
    "export.encryptedHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل شيء، والملفات المرفقة معه، مشفّرًا بكلمة مرور تختارها. استخدمه للنسخ الاحتياطي وللانتقال إلى حساب آخر في Octa Pass."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything, attached files included, encrypted with a password you choose. Use it for backups and to move to another Octa Pass account."
          }
        }
      }
    },
    "export.encryptedNote" : {
      "extractionState" : "manual",
