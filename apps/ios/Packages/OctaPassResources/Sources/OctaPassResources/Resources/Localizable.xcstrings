    "organisation.accessHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقول الخادم إن هؤلاء الأشخاص يجب أن يحصلوا على هذه الخزائن. هذا الجهاز وحده يستطيع منحهم المفتاح، لذا تحقق من كل شخص أولًا. وقارن البصمات معهم إن أمكن."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server says these people should have these vaults. Only this device can give them the key, so check each person first. Compare fingerprints with them if you can."
          }
        }
      }
    },
