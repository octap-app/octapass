    "wifi.importWindows" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يعطي Windows كلمات مرور Wi-Fi إلا للتطبيقات التي تعمل بصلاحيات المسؤول. الشبكة التي لا يعطي Windows كلمة مرورها تُستورد من دونها، ويمكنك كتابتها لاحقًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows gives Wi-Fi passwords only to apps running as an administrator. A network whose password Windows won’t give comes in without it, and you can type it in later."
          }
        }
      }
    },
    "wifi.inRange" : {
      "extractionState" : "manual",
