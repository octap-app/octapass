    "localVault.guidance" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد حساب لإعادة تعيينها منه، لذلك اختر عبارة مرور طويلة تتذكرها. لا يوجد استرداد يتجاوز نسخك الاحتياطية. إذا فقدت هذا الجهاز ونسخك الاحتياطية ورمز الاسترداد، ضاعت الخزنة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There’s no account to reset it from, so choose a long passphrase you’ll remember. There is no recovery beyond your backups. If you lose this device, your backups and your recovery code, the vault is gone."
          }
        }
      }
    },
