{
  "description": "Sign-up with full name, work email and a single new password; labels only, no autocomplete",
  "fields": {
    "#fullname": "name",
    "#workemail": "email",
    "#pass": "new-password"
  },
  "forms": [{ "field": "#pass", "type": "signup" }],
  "fills": [
    {
      "focus": "#pass",
      "pick": "generated-password",
      "expect": { "#fullname": "", "#workemail": "", "#pass": "Lantern-ruby-T7#qv-42" }
    }
  ]
}
