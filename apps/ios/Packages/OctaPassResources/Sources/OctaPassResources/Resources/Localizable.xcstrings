    "wifi.importMac" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ macOS كلمات مرور Wi-Fi في سلسلة مفاتيح النظام. لكل شبكة تختارها يطلب macOS اسم مسؤول وكلمة مروره قبل أن يعطي كلمة المرور لـ Octa Pass. تلك النافذة من macOS نفسه: لا يرى Octa Pass ما تكتبه فيها ولا يحتفظ به."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS keeps Wi-Fi passwords in the System keychain. For each network you choose, macOS asks for an administrator’s name and password before it gives the password to Octa Pass. That window is macOS’s own: Octa Pass never sees or keeps what you type there."
          }
        }
      }
    },
    "wifi.importNoPassword" : {
      "extractionState" : "manual",
      "localizations" : {
