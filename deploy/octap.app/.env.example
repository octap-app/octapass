# Copy to .env on the server (never commit it): cp .env.example .env && chmod 600 .env

# The image tag ./deploy.sh built and copied over (it updates this line for you).
OCTAPASS_TAG=

# A long random password: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=

# Brevo SMTP (Transactional > SMTP & API). Percent-encode the login and key:
# "@" becomes %40, ":" %3A, "/" %2F. Port 587 with STARTTLS required:
#   smtp://LOGIN%40smtp-brevo.com:SMTP_KEY@smtp-relay.brevo.com:587?tls=required
OCTAPASS_SMTP_URL=
# Must be a sender or domain verified in Brevo (add Brevo's DKIM/DMARC records for octap.app).
OCTAPASS_SMTP_FROM=Octa Pass <no-reply@octap.app>

# open (default), invite or closed. Set to closed to pause new sign-ups.
OCTAPASS_SIGNUPS=open

OCTAPASS_LOG=info
BACKUP_KEEP_DAYS=14
