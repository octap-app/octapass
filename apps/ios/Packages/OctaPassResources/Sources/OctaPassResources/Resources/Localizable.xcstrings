    "keyLog.failedHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجلّ المفاتيح لا يؤكّد هذه المفاتيح. لا يمكن المشاركة مع هذا الحساب حتى تُحلّ المشكلة. قارن البصمات في مكالمة، وتعامل مع الخادم بحذر."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The key log doesn’t back up these keys. Nothing can be shared with this account until that’s sorted out. Compare fingerprints on a call, and treat the server with suspicion."
          }
        }
      }
    },
    "keyLog.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُسجَّل المفاتيح العامة لكل حساب في سجلّ لا يقبل إلا الإضافة ويقرؤه هذا الجهاز، فلا يستطيع الخادم تبديل مفتاح دون أن يترك أثرًا. وهو يُكمّل مقارنة البصمات ولا يحلّ محلّها، ولم يخضع بعد لمراجعة خبير تشفير خارجي."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every account’s public keys go into an append-only log that this device reads, so the server can’t swap a key without leaving a trace. It adds to comparing fingerprints and doesn’t replace it, and it hasn’t yet had the outside cryptographer’s review."
          }
        }
      }
    },
