    "organisation.joinOwners" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لمالكي المؤسسة الحصول على وصول إلى كل خزنة للمؤسسة تستخدمها. ولا يمكنهم الوصول إلى أي شيء خارج تلك الخزائن."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organisation owners can get access to every organisation vault you use. They can’t reach anything outside those vaults."
          }
        }
      }
    },
    "organisation.joinPrivacy" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى خزنتك الشخصية خاصة: لا يستطيع أحد في المؤسسة قراءتها، ولا يستطيع المسؤولون إعادة تعيين كلمة مرورك الرئيسية."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your personal vault stays private: nobody in the organisation can read it, and admins can’t reset your master password."
          }
        }
      }
    },
