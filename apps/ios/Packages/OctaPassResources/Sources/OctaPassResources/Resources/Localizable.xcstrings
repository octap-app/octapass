    "family.recovery.warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن يستطيع المنظّم قراءة خزنتك، لكن إعادة التعيين تعطيه كلمة المرور الجديدة. يصلك بريد إلكتروني عند طلبه، ويمكنك الرفض حتى تنتهي فترة الانتظار."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your organiser couldn’t read your vault, but a reset gives them the new password. You’re emailed when they ask, and you can deny it until the wait ends."
          }
        }
      }
    },
