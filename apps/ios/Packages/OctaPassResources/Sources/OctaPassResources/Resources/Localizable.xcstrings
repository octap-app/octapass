    "serviceAccounts.revokeBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتوقف رمزه عن العمل الآن، وتحصل الخزنة على مفتاح جديد. ما قرأه من قبل يظل معروفًا لمن كان يحمل الرمز، فغيّر تلك الأسرار إذا تسرّب الرمز."
          }
