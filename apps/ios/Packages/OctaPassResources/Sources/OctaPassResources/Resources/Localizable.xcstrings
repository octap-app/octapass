    "takeover.warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُسجَّل خروج %1$@ من كل مكان، وتتوقف كلمة مروره ومفتاحه السري ورمز الاسترداد عن العمل. ويتوقف تسجيل الدخول بخطوتين. ولا يمكن التراجع عن هذا. ويصله بريد إلكتروني فورًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ will be signed out everywhere, and their password, Secret Key and recovery code stop working. Two-step sign-in is turned off. This can’t be undone. They’re emailed straight away."
          }
        }
      }
    },
