    "changePassword.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل كلمة المرور الرئيسية الحالية، ثم اختر كلمة جديدة. يبقى مفتاحك السري ورمز الاسترداد كما هما."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter your current master password, then choose a new one. Your Secret Key and recovery code stay the same."
          }
        }
      }
    },
    "changePassword.newRequired" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر كلمة مرور رئيسية جديدة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a new master password."
          }
        }
      }
    },
    "changePassword.rowHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفتح خزنتك على كل جهاز. يبقى مفتاحك السري كما هو."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlocks your vault on every device. Your Secret Key stays the same."
          }
