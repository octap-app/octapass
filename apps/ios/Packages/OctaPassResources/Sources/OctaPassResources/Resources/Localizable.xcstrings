    "phone.native.safesFilesCopies" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتفظ تطبيق «الملفات» بنسخ من الملفات التي تفتحها فيه حتى تُقفل خزنتك. وتُغلق خزائنك فيه حين يحين وقت القفل التلقائي لـ Octa Pass، محسوبًا من آخر مرة استخدمت فيها التطبيق."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Files keeps copies of the files you open there until your vault locks. Your Safes close in Files when Octa Pass would auto-lock, counted from when you last used the app."
          }
        }
      }
    },
    "phone.native.safesFinderCopies" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتفظ Finder بنسخ من الملفات التي تفتحها فيه حتى تُقفل خزنتك. وتُغلق خزائنك فيه حين يحين وقت القفل التلقائي لـ Octa Pass، محسوبًا من آخر مرة استخدمت فيها التطبيق."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder keeps copies of the files you open there until your vault locks. Your Safes close in Finder when Octa Pass would auto-lock, counted from when you last used the app."
          }
        }
      }
    },
    "phone.native.safesInFiles" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر الخزائن المفتوحة في تطبيق «الملفات» وفي منتقي الملفات في أي تطبيق ما دامت خزنتك غير مقفلة. وعند قفلها تختفي من هناك."
          }
