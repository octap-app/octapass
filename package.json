{
  "name": "octapass",
  "private": true,
  "description": "Octa Pass — an open-source, end-to-end encrypted password manager.",
  "license": "MIT",
  "packageManager": "pnpm@11.5.2",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @octapass/website dev",
    "build": "pnpm --filter @octapass/website build",
    "preview": "pnpm --filter @octapass/website preview",
    "check": "pnpm --filter @octapass/website check",
    "start": "scripts/serve.sh --build",
    "serve": "scripts/serve.sh",
    "dev:api": "mkdir -p \"$HOME/.octapass-dev\" && OCTAPASS_DEV_MODE=true OCTAPASS_RATE_LIMITS=off OCTAPASS_BIND=127.0.0.1:8080 OCTAPASS_WEB_ORIGINS=http://localhost:5174 OCTAPASS_DATA_DIR=\"$HOME/.octapass-dev\" cargo run -p octapass-server",
    "dev:web": "pnpm --filter @octapass/web dev",
    "dev:stack": "pnpm --filter @octapass/web dev:stack",
    "dev:extension": "pnpm --filter @octapass/extension dev",
    "dev:ios": "apps/ios/scripts/simulator.sh",
    "dev:ios:device": "apps/ios/scripts/device.sh",
    "dev:android": "scripts/android.sh dev",
    "build:api": "cargo build --release -p octapass-server",
    "build:web": "pnpm --filter @octapass/core build:if-stale && VITE_SERVER_URL=same-origin pnpm --filter @octapass/web build",
    "build:extension": "scripts/build-app.sh extension",
    "build:safari": "scripts/build-app.sh safari",
    "build:ios": "scripts/build-app.sh ios",
    "build:android": "scripts/build-app.sh android",
    "build:desktop": "scripts/build-app.sh desktop",
    "build:macos": "scripts/build-app.sh macos",
    "build:windows": "scripts/build-app.sh windows",
    "build:linux": "scripts/build-app.sh linux",
    "build:cli": "scripts/build-app.sh cli",
    "build:vscode": "scripts/build-app.sh vscode",
    "build:jetbrains": "scripts/build-app.sh jetbrains"
  }
}
