{
  "description": "Reset-password page reached from an emailed link: \"New password\" + \"Confirm new password\" only, no identifier, no autocomplete, generic name=\"password\" on the new field",
  "fields": {
    "#password": "new-password",
    "#password_confirmation": "confirm-password"
  },
  "forms": [{ "field": "#password", "type": "change-password" }],
  "fills": [
    {
      "focus": "#password",
      "pick": "generated-password",
      "expect": { "#password": "Lantern-ruby-T7#qv-42", "#password_confirmation": "Lantern-ruby-T7#qv-42" }
    }
  ],
  "saves": [
    {
      "steps": [
        { "type": ["#password", "Brand-new-pass-77"] },
        { "type": ["#password_confirmation", "Brand-new-pass-77"] },
        { "click": "#reset-btn" }
      ],
      "expect": { "username": "", "password": "Brand-new-pass-77", "formType": "change-password" }
    }
  ]
}
