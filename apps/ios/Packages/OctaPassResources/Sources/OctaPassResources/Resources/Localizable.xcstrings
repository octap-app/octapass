    "deviceAuth.webVault" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خزنة الويب تسأل دائمًا عن كلمة المرور الرئيسية أو فتح القفل بالجهاز. صفحة الويب لا تعرف من يجلس أمامها، لذلك لا تقدّم وضعًا بلا تحقق أبدًا."
