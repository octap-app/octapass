    "wifi.androidImport" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يسمح Android للتطبيقات بقراءة كلمات مرور Wi-Fi المحفوظة. لإحضار شبكة افتحها في الإعدادات واضغط «مشاركة»: يعرض Android رمز QR الخاص بها. ثم امسح ذلك الرمز هنا عبر «مسح رمز QR»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android doesn’t let apps read saved Wi-Fi passwords. To bring a network in, open it in Settings and tap Share: Android shows its QR code. Then scan that code here with Scan a QR code."
          }
        }
      }
    },
