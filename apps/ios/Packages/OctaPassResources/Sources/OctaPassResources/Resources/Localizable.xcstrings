    "deviceAuth.stayUnlockedOn" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لأي شخص يستخدم هذا الجهاز وهو غير مقفل أن يفتح Octa Pass ويعبّئ بيانات دخولك ويرى كلمات مرورك. أمّا التصدير وإظهار المفتاح السري فما زالا يطلبان %1$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone who can use this device while it’s unlocked can open Octa Pass, fill your logins and see your passwords. Exporting and showing your Secret Key still ask for %1$@."
          }
        }
      }
    },
    "deviceAuth.stayUnlockedPassword" : {
      "extractionState" : "manual",
      "localizations" : {
